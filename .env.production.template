# Production Environment Configuration
# Copy this file to .env.production and customize for your deployment

# Application Settings
REFLEX_ENV=prod
APP_NAME=car-sales-dashboard
APP_VERSION=1.0.0
DEBUG=False

# Server Configuration
HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-production-secret-key-change-this
CORS_ALLOWED_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com", "www.yourdomain.com", "localhost"]

# Database Configuration (if using external database)
# DATABASE_URL=postgresql://user:pass@localhost:5432/car_sales_db
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/dashboard.log
ERROR_LOG_FILE=/app/logs/dashboard_errors.log

# Monitoring & Observability
SENTRY_DSN=your-sentry-dsn-here
ENABLE_METRICS=True
HEALTH_CHECK_ENDPOINT=/healthz

# ML Model Configuration
MODEL_CACHE_SIZE=100
MODEL_RETRAIN_INTERVAL_HOURS=24
MAX_FORECAST_PERIODS=365

# Performance Settings
ENABLE_COMPRESSION=True
STATIC_FILES_MAX_AGE=86400
API_RATE_LIMIT_PER_MINUTE=60

# SSL/TLS (when using reverse proxy)
FORCE_HTTPS=True
SECURE_COOKIE_ATTRIBUTES=True

# Development/Testing (set to False in production)
ENABLE_DEBUG_ROUTES=False
ENABLE_TEST_DATA=False
